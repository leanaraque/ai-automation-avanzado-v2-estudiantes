    {
      "parameters": {
        "jsCode": "// Return Intermediate Steps = ON → el agente devuelve los pasos que hizo\nconst out = $input.first().json;\nconst pasos = (out.intermediateSteps || []).map((s, i) => {\n  const a = s.action || {};\n  const obs = typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation);\n  return `Paso ${i + 1}: usó ${a.tool} con ${JSON.stringify(a.toolInput)} → ${(obs || '').slice(0, 200)}`;\n});\nreturn [{ json: {\n  output: out.output,\n  agentThought: pasos.length ? pasos.join(' | ') : 'Respondió sin usar herramientas'\n} }];"
      },
