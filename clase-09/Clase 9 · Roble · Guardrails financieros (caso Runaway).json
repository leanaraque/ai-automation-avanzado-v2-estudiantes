      "parameters": {
        "jsCode": "// 👇 Tope de mensajes por sesión y por hora\nconst LIMITE = 5;\n\nconst usados = $input.all().filter(i => i.json && i.json.id).length;\nconst chat = $('Chat cliente').first().json;\nreturn [{ json: {\n  sessionId: chat.sessionId,\n  chatInput: chat.chatInput,\n  mensajes_esta_hora: usados,\n  limite: LIMITE,\n  superado: usados >= LIMITE\n} }];"
      },
