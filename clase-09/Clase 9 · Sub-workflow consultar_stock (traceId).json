    {
      "parameters": {
        "jsCode": "const catalogo = {\n  'mesa nórdica 160': { stock: 4, precio: 485000 },\n  'mesa nórdica 200': { stock: 0, precio: 590000 },\n  'silla escandinava': { stock: 22, precio: 78000 },\n  'rack tv roble': { stock: 2, precio: 320000 },\n  'cama paraíso 2 plazas': { stock: 1, precio: 710000 }\n};\nconst { producto = '', traceId, environment } = $input.first().json;\nconst q = producto.toLowerCase();\nconst key = Object.keys(catalogo).find(k => q.includes(k) || k.includes(q));\nconst resultado = key\n  ? { producto: key, stock: catalogo[key].stock, precio_ARS: catalogo[key].precio }\n  : { error: 'Producto no encontrado', disponibles: Object.keys(catalogo) };\nreturn [{ json: { traceId, environment, resultado } }];"
      },
